# =============================================================================
#  Portus — copy to .env, then after deploying run:  npm run sync-env -- <chainId>
#  to fill in the contract addresses from deployments/<chainId>.json.
#
#  Obscura-era names (OBSCURA_*, LAUNCHPAD_*, AGENT_*) are no longer read.
#  The frozen MCP server keeps its own example at frozen/mcp-server/.env.example.
# =============================================================================

# ---------- network ----------
# 31337 = local Hardhat node
# 46630 = Robinhood Chain Testnet  (preferred testnet)
# 4663  = Robinhood Chain          (mainnet — phase-1 deploys are refused)
# 1     = Ethereum                 (mainnet — phase-1 deploys are refused)
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# Robinhood Chain's public RPCs are rate-limited and documented as not for
# production; use your own provider (e.g. Alchemy) for anything long-running.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Sepolia (re-added for test deployments; chain EOL 2026-09-30)
SEPOLIA_RPC_URL=
ROBINHOOD_RPC_URL=
# No public default for Ethereum: set your provider's endpoint.
ETHEREUM_RPC_URL=

# Filled in by `npm run sync-env -- <chainId>`
PORTUS_FACTORY_ADDRESS=
PORTUS_LOCKER_ADDRESS=
PORTUS_FEE_SPLITTER_ADDRESS=
PORTUS_DISTRIBUTOR_ADDRESS=
PORTUS_FLYWHEEL_ADDRESS=

# ---------- deployment ----------
# Deploys the factory and its libraries. Only needed by contracts/.
# MUST NOT be a Hardhat default account on a public network — the deploy script
# refuses. Generate one with:  npm run newkey
DEPLOYER_PRIVATE_KEY=

# Quote-asset curator written into the factory (a multisig on public networks;
# defaults to the deployer on a local chain). It can only affect FUTURE launches.
PORTUS_QUOTE_ADMIN=
# Receives the 20% ecosystem fee share (written into the factory; multisig).
PORTUS_ECOSYSTEM=
# Publishes radar / treasury-reward Merkle roots (written into the factory; multisig).
PORTUS_ROOT_PUBLISHER=
# Mainnet deployment stays refused until this is set after an external audit.
# PORTUS_MAINNET_AUDITED=yes

# Etherscan V2 key (one key, all chains) for `npm run verify:ethereum`.
# Sourcify verification runs without it.
ETHERSCAN_API_KEY=
# Blockscout key for Robinhood Chain explorers, if one turns out to be required (N10).
BLOCKSCOUT_API_KEY=

# Demo launch at deploy time (local only).
SALE_MINUTES=60
SEED_DEMO_LAUNCH=true

# ---------- apps/keeper ----------
# Calls finalize() / sweepDust(). Holds no privilege; fund it with a little ETH.
KEEPER_PRIVATE_KEY=
KEEPER_INTERVAL_SECONDS=30
# KEEPER_SWEEP_DUST=true
# KEEPER_LOW_BALANCE_ETH=0.01

# ---------- apps/api ----------
API_PORT=8787
DATABASE_PATH=./data/portus.sqlite

# ---------- apps/web ----------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# Public because the create page encodes createLaunch in the browser.
NEXT_PUBLIC_PORTUS_FACTORY_ADDRESS=
# Link target for "Docs" in the header.
NEXT_PUBLIC_DOCS_URL=
